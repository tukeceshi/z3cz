# 复制为 .env.docker 后使用：docker compose --env-file .env.docker up --build

# 本地开发端口（容器内外一致）
WWW_PORT=3100
APP_PORT=3101
API_PORT=3102

NODE_VERSION=20.19.0
PNPM_VERSION=10.3.0

# Cloudflare 凭证（可选；远程 preview / AI / R2 等功能需要）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 设为 false 可跳过容器启动时的 D1 迁移
RUN_DB_MIGRATE=true
