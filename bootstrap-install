#!/usr/bin/env bash
# Thin wrapper: download install-dafthunk to a file, then exec (works with curl | bash).
set -euo pipefail

URL="${DAFTHUNK_INSTALLER_URL:-https://raw.githubusercontent.com/tukeceshi/dafthunk/main/install-dafthunk}"
TARGET="${DAFTHUNK_INSTALL_SCRIPT:-/tmp/dafthunk-install.sh}"

if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$URL" -o "$TARGET"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TARGET" "$URL"
else
  echo "Need curl or wget." >&2
  exit 1
fi

chmod +x "$TARGET"
exec bash "$TARGET" "$@"
