#!/usr/bin/env bash
# Downloads scripts/host/bootstrap.sh and runs it.
set -euo pipefail

URL="${DAFTHUNK_BOOTSTRAP_URL:-https://raw.githubusercontent.com/tukeceshi/dafthunk/main/scripts/host/bootstrap.sh}"
TARGET="${DAFTHUNK_BOOTSTRAP_SCRIPT:-/tmp/dafthunk-bootstrap.sh}"

if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$URL" -o "$TARGET"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TARGET" "$URL"
else
  echo "Need curl or wget." >&2
  exit 1
fi

chmod +x "$TARGET"
exec bash "$TARGET" "$@"
