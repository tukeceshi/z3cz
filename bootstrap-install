#!/usr/bin/env bash
# Download install-dafthunk, then exec. Works with: curl .../bootstrap-install | sudo bash
set -euo pipefail

URL="${DAFTHUNK_INSTALLER_URL:-https://raw.githubusercontent.com/tukeceshi/dafthunk/main/install-dafthunk}"
TARGET="${DAFTHUNK_INSTALL_SCRIPT:-/tmp/dafthunk-install.sh}"
MARKER="DAFTHUNK_INSTALL_VERSION=2"

rm -f "$TARGET"

if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$URL" -o "$TARGET"
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TARGET" "$URL"
else
  echo "Need curl or wget." >&2
  exit 1
fi

if ! grep -q "$MARKER" "$TARGET"; then
  echo "ERROR: Downloaded installer is outdated or corrupt." >&2
  echo "Delete ${TARGET} and retry, or check network access to GitHub." >&2
  rm -f "$TARGET"
  exit 1
fi

chmod +x "$TARGET"
echo "Dafthunk installer ready ($(wc -l <"$TARGET" | tr -d ' ') lines) → starting…" >&2
exec bash "$TARGET" "$@"
