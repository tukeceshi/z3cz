#!/usr/bin/env bash
# Dafthunk one-line bootstrap — download install-dafthunk, then run interactively.
#
# Recommended:
#   curl -fsSL …/bootstrap-install -o /tmp/bootstrap-install.sh
#   sudo bash /tmp/bootstrap-install.sh --lang zh 0</dev/tty
#
# One-liner (needs foreground TTY):
#   curl -fsSL …/bootstrap-install | sudo bash
set -euo pipefail

INSTALLER_URL="${DAFTHUNK_INSTALLER_URL:-https://raw.githubusercontent.com/tukeceshi/dafthunk/main/install-dafthunk}"
TARGET="${DAFTHUNK_INSTALL_SCRIPT:-/tmp/dafthunk-install.sh}"

# Re-use already-deployed fixed script (GitHub raw may lag behind).
if [[ -f "$TARGET" ]] && grep -q 'has_tty()' "$TARGET" 2>/dev/null; then
  :
elif command -v wget >/dev/null 2>&1; then
  wget -qO "$TARGET" "$INSTALLER_URL"
elif command -v curl >/dev/null 2>&1; then
  curl -fsSL "$INSTALLER_URL" -o "$TARGET"
else
  echo "Need wget or curl to download the installer." >&2
  exit 1
fi

chmod +x "$TARGET"
exec bash "$TARGET" --lang ask "$@" 0</dev/tty
