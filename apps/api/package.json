{
  "name": "@dafthunk/api",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "imports": {
    "cloudflare:workflows": "./src/shims/cloudflare-workflows.ts",
    "cloudflare:workers": "./src/shims/cloudflare-workers.ts",
    "cloudflare:email": "./src/shims/cloudflare-email.ts"
  },
  "scripts": {
    "dev": "tsx watch --import ./src/shims/cloudflare-register.mjs --env-file=.dev.vars src/server.ts",
    "dev:docker": "tsx watch --import ./src/shims/cloudflare-register.mjs --env-file=.dev.vars src/server.ts",
    "start:node": "tsx --import ./src/shims/cloudflare-register.mjs src/server.ts",
    "dev:workers": "wrangler dev --local --live-reload --port 3102 --ip 0.0.0.0 --enable-containers=false",
    "dev:preview": "wrangler dev --remote --port 3102",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts --passWithNoTests",
    "deploy": "RUNTIME_VERSION=$(git rev-parse HEAD) wrangler deploy --env production --define RUNTIME_VERSION:\"\\\"$RUNTIME_VERSION\\\"\"",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/reset-all-data.mjs",
    "db:prod:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "generate:master-key": "node scripts/generate-master-key.js",
    "generate:secrets": "node scripts/generate-master-key.js",
    "fonts:seed": "pnpm --filter '@dafthunk/runtime' fonts:fetch && node scripts/seed-fonts.mjs dafthunk-ressources-development --local",
    "fonts:prod:seed": "pnpm --filter '@dafthunk/runtime' fonts:fetch && node scripts/seed-fonts.mjs dafthunk-ressources-production --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.5",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@types/node": "^22.19.19",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.10",
    "partyserver": "^0.5.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@cloudflare/containers": "^0.1.1",
    "@cloudflare/sandbox": "^0.7.21",
    "@dafthunk/runtime": "workspace:*",
    "@dafthunk/types": "workspace:*",
    "@google/genai": "^1.52.0",
    "@hono-rate-limiter/cloudflare": "^0.2.2",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.2.0",
    "@hono/oauth-providers": "^0.8.5",
    "@hono/zod-validator": "^0.7.6",
    "agents": "^0.13.2",
    "aws4fetch": "^1.0.20",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.26",
    "hono-rate-limiter": "^0.4.2",
    "jose": "^6.2.3",
    "nanoid": "^5.1.11",
    "openai": "^6.37.0",
    "postal-mime": "^2.7.4",
    "postgres": "^3.4.7",
    "stripe": "^20.4.1",
    "uuid": "^13.0.2",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  }
}
