# Internal readiness is independent of the public domain and maintenance page.
http://:8081 {
	bind 127.0.0.1
	handle /health {
		rewrite * /health/ready
		reverse_proxy api:3001
	}
}

{$Z3CZ_SITE_ADDRESS::80} {
	encode gzip zstd
	@maintenance file /srv/maintenance/enabled
	respond @maintenance "系统正在更新，请稍后刷新。" 503
	handle_path /api/* {
		reverse_proxy api:3001
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
