# Caddy 自身的存活检查。不转发 API：引擎冷启动时四个服务同时起来，
# 数据库恢复可能晚于 Caddy。API 与数据库由各自的检查和部署验收负责。
http://:8081 {
	bind 127.0.0.1
	handle /health {
		respond "ok" 200
	}
}

{$Z3CZ_SITE_ADDRESS::80} {
	encode gzip zstd
	@maintenance file /srv/maintenance/enabled
	respond @maintenance "系统正在更新，请稍后刷新。" 503
	handle_path /api/* {
		reverse_proxy api:3001
	}
	handle {
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}
