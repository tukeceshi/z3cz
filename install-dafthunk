#!/usr/bin/env bash
#
# Dafthunk One-Line Installer (Discourse-style)
#
# Usage (one shot: env prep + clone + setup + rebuild):
#   curl -fsSL https://raw.githubusercontent.com/tukeceshi/dafthunk/main/bootstrap-install | sudo bash
#
# Resume after disconnect / re-run safely:
#   sudo bash /var/dafthunk/install-dafthunk --resume
#
# Env:
#   DAFTHUNK_INSTALL_DIR=/opt/dafthunk
#   DAFTHUNK_REPO_URL=...
#   DAFTHUNK_BRANCH=main
#   DAFTHUNK_TARGET_RAM_MIB=4096   # default total memory+swap target
#   DAFTHUNK_RAM_SLACK_MIB=256     # soft-meet slack for "memory check passed"
#   DAFTHUNK_LANG=zh|en|ask         # prompt language (interactive default: menu)
#   DAFTHUNK_TZ_SUGGEST=Asia/Shanghai  # suggested timezone when changing
#   DAFTHUNK_ASK_TIMEOUT=900       # interactive prompt timeout seconds (0=disable)
#   DAFTHUNK_NON_INTERACTIVE=1     # use defaults without prompting (CI only)
#
set -euo pipefail

INSTALLER_URL="${DAFTHUNK_INSTALLER_URL:-https://raw.githubusercontent.com/tukeceshi/dafthunk/main/install-dafthunk}"
BOOTSTRAP_URL="${DAFTHUNK_BOOTSTRAP_URL:-https://raw.githubusercontent.com/tukeceshi/dafthunk/main/bootstrap-install}"
INSTALL_ONE_LINER="curl -fsSL ${BOOTSTRAP_URL} | sudo bash"
INSTALL_DIR="${DAFTHUNK_INSTALL_DIR:-/var/dafthunk}"
REPO_URL="${DAFTHUNK_REPO_URL:-https://github.com/tukeceshi/dafthunk.git}"
BRANCH="${DAFTHUNK_BRANCH:-main}"
TARGET_TOTAL_MIB="${DAFTHUNK_TARGET_RAM_MIB:-4096}"
RAM_SLACK_MIB="${DAFTHUNK_RAM_SLACK_MIB:-256}"
SWAPFILE="${DAFTHUNK_SWAPFILE:-/swapfile}"
TZ_SUGGEST="${DAFTHUNK_TZ_SUGGEST:-Asia/Shanghai}"
ASK_TIMEOUT_SEC="${DAFTHUNK_ASK_TIMEOUT:-900}"
NON_INTERACTIVE="${DAFTHUNK_NON_INTERACTIVE:-0}"
# Log to /tmp until clone finishes — writing into INSTALL_DIR first makes git clone fail.
TEMP_LOG="${DAFTHUNK_INSTALL_LOG_TMP:-/tmp/dafthunk-install-$$.log}"
APT_LOG="${TEMP_LOG}.apt.log"
LOG_FILE="$TEMP_LOG"
NODE_IMAGE="${DAFTHUNK_NODE_IMAGE:-node:22.12.0-bookworm-slim}"
REBUILD_EXIT_FILE=".rebuild.exit"
LOGGING_STARTED=0

RESUME=0
SKIP_DOCKER=0
SKIP_SWAP=0
FORCE_SETUP=0
LANG_FLAG=""
UI_LANG="zh"
SHOW_HELP=0

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

log_info() { echo -e "${GREEN}→${NC} $1"; }
log_warn() { echo -e "${YELLOW}!${NC} $1"; }
log_error() { echo -e "${RED}✗${NC} $1"; }
log_step() { echo -e "${BLUE}${BOLD}==>${NC}${BOLD} $1${NC}"; }

# Interactive I/O goes to /dev/tty only (never stdin — fd 0 may be closed or a dead pipe).
has_tty() {
  [[ -r /dev/tty && -w /dev/tty ]]
}

ensure_stdin_tty() {
  if [[ "$NON_INTERACTIVE" == "1" ]] || [[ -t 0 ]]; then
    return 0
  fi
  if has_tty; then
    exec </dev/tty
  fi
}

write_prompt_tty() {
  local msg="$1"
  if has_tty; then
    stty -F /dev/tty sane 2>/dev/null || true
    printf '%s\n' "$msg" >/dev/tty
  elif [[ -t 1 ]]; then
    stty sane 2>/dev/null || true
    printf '%s\n' "$msg"
  else
    printf '%s\n' "$msg" >&2
  fi
}

can_prompt() {
  if [[ "$NON_INTERACTIVE" == "1" ]]; then
    return 1
  fi
  [[ -t 0 ]] || has_tty
}

