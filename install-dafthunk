#!/usr/bin/env bash
# Deprecated wrapper — runs bootstrap → configure → deploy when scripts exist.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${DAFTHUNK_INSTALL_DIR:-/var/dafthunk}"
BASE="${ROOT}/scripts/host"

run() {
  local script="$1"
  shift
  [[ -f "$script" ]] || {
    cat >&2 <<EOF
install-dafthunk is deprecated.

Use three steps (download each script, then run):

  curl -fsSL "https://raw.githubusercontent.com/tukeceshi/dafthunk/main/bootstrap-install" | sudo bash

  sudo DAFTHUNK_HOSTNAME=your.domain ${INSTALL_DIR}/scripts/host/configure.sh

  sudo ${INSTALL_DIR}/scripts/host/deploy.sh

See README.md
EOF
    exit 1
  }
  bash "$script" "$@"
}

run "${BASE}/bootstrap.sh"
run "${BASE}/configure.sh" "$@"
run "${BASE}/deploy.sh" "$@"
