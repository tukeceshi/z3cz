#!/usr/bin/env bash
# Compatibility wrapper for the one-command installer.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
INSTALL_DIR="${DAFTHUNK_INSTALL_DIR:-/var/dafthunk}"
BOOTSTRAP="${ROOT}/scripts/host/bootstrap.sh"
[[ -f "$BOOTSTRAP" ]] || { echo "Missing $BOOTSTRAP" >&2; exit 1; }
exec bash "$BOOTSTRAP" "$@"
