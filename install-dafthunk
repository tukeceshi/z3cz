else
  log_info "$(M skip_pkgs)"
  if ! command -v docker >/dev/null 2>&1; then
    log_error "$(M docker_not_found)"
    exit 1
  fi
  if ! has_docker_compose; then
    log_error "$(M compose_not_found)"
    exit 1
  fi
  if ! command -v git >/dev/null 2>&1; then
    log_error "$(M git_not_found)"
    exit 1
  fi
fi

setup_repo
rebuild_rc=0
run_setup_and_rebuild || rebuild_rc=$?

print_install_summary "$rebuild_rc"
if ((rebuild_rc == 0)); then
  log_info "$(M done)"
else
  log_error "$(M rebuild_failed "$(rebuild_log_path)")"
  exit "$rebuild_rc"
fi
