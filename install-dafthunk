normalize_lang() {
  local raw
  raw="$(echo "$1" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  case "$raw" in
    zh|zh-cn|zh_cn|cn|chinese|中文) echo "zh" ;;
    en|en-us|en_us|english) echo "en" ;;
    ask) echo "ask" ;;
    *) return 1 ;;
  esac
}

# --lang / DAFTHUNK_LANG (zh|en|ask). "ask" defers to choose_ui_lang_interactive.
apply_lang_from_flag_or_env() {
  local normalized
  if [[ -n "$LANG_FLAG" ]]; then
    if ! normalized="$(normalize_lang "$LANG_FLAG")"; then
      echo "Invalid --lang '$LANG_FLAG' (use zh, en, or ask)." >&2
      exit 1
    fi
    if [[ "$normalized" == "ask" ]]; then
      UI_LANG="zh"
      return 0
    fi
    UI_LANG="$normalized"
    return 0
  fi
  if [[ -n "${DAFTHUNK_LANG:-}" ]]; then
    if ! normalized="$(normalize_lang "$DAFTHUNK_LANG")"; then
      echo "Invalid DAFTHUNK_LANG='$DAFTHUNK_LANG' (use zh, en, or ask)." >&2
      exit 1
    fi
    if [[ "$normalized" == "ask" ]]; then
      UI_LANG="zh"
      return 0
    fi
    UI_LANG="$normalized"
    return 0
  fi
  UI_LANG="zh"
}

# Interactive: language menu when TTY and no --lang / DAFTHUNK_LANG. Explicit zh|en skips menu.
choose_ui_lang_interactive() {
  if [[ -n "$LANG_FLAG" ]]; then
    if [[ "$(echo "$LANG_FLAG" | tr '[:upper:]' '[:lower:]')" == "ask" ]]; then
      :
    else
      return 0
    fi
  elif [[ -n "${DAFTHUNK_LANG:-}" ]]; then
    if [[ "$(echo "$DAFTHUNK_LANG" | tr '[:upper:]' '[:lower:]')" == "ask" ]]; then
      :
    else
      return 0
    fi
  elif ! can_prompt; then
    UI_LANG="zh"
    return 0
  fi
  if ! can_prompt; then
    UI_LANG="zh"
    return 0
  fi
  write_prompt_tty ""
  write_prompt_tty "提示语言 / Prompt language"
  write_prompt_tty "  1) 中文（默认）"
  write_prompt_tty "  2) English"
  local choice
  ask_into choice "选择 / Choice [1]: " "1"
  case "$choice" in
    2|en|EN|english|English) UI_LANG="en" ;;
    *) UI_LANG="zh" ;;
  esac
}

# Status / prompts — never stdout (reserved for $() capture).
# Write once to stderr (tee → log + console). Do NOT also write /dev/tty (duplicates).
ask_status() {
  local msg="$1"
  echo -e "${GREEN}→${NC} $msg" >&2
}

announce() {
  local msg="$1"
  echo -e "${BLUE}${BOLD}==>${NC}${BOLD} $msg${NC}"
}

ask_timeout_exit() {
  ask_status "$(M ask_timeout "$ASK_TIMEOUT_SEC")"
  echo "$(M ask_timeout_hint)" >&2
  echo "$(M ask_timeout_hint2)" >&2
  exit 1
}

ask_read_failed_exit() {
  log_error "$(M ask_read_failed)"
  echo "$(M ask_read_failed_hint)" >&2
  exit 1
}

# Read one line interactively. Empty line after successful read → caller uses default.
# Failed read (EOF/error) → exit; never silently substitute defaults.
read_interactive_line() {
  local __var="$1"
  local value=""
  local rc=0

  if has_tty; then
    stty -F /dev/tty sane 2>/dev/null || true
    if ((ASK_TIMEOUT_SEC > 0)); then
      if ! read -r -t "$ASK_TIMEOUT_SEC" value </dev/tty; then
        rc=$?
        if ((rc == 142 || rc == 143)); then
          ask_timeout_exit
        fi
        ask_read_failed_exit
      fi
    elif ! read -r value </dev/tty; then
      ask_read_failed_exit
    fi
  elif [[ -t 0 ]]; then
    stty sane 2>/dev/null || true
    if ((ASK_TIMEOUT_SEC > 0)); then
      if ! read -r -t "$ASK_TIMEOUT_SEC" value; then
        rc=$?
        if ((rc == 142 || rc == 143)); then
          ask_timeout_exit
        fi
        ask_read_failed_exit
      fi
    elif ! read -r value; then
      ask_read_failed_exit
    fi
  else
    ask_read_failed_exit
  fi

  value="$(printf '%s' "${value:-}" | tr -d '\r')"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf -v "$__var" '%s' "$value"
}

# Set answer in caller variable (never use $(ask…) — subshell hides exit).
ask_into() {
  local __var="$1"
  local prompt="$2"
  local default="$3"

  if ! can_prompt; then
    ask_status "$(M non_interactive_default "$prompt" "$default")"
    printf -v "$__var" '%s' "$default"
    return 0
  fi

  write_prompt_tty "$prompt"
  read_interactive_line "$__var"
  if [[ -z "${!__var:-}" ]]; then
    printf -v "$__var" '%s' "$default"
  fi
}

ask_yes_no() {
  local prompt="$1"
  local default="${2:-Y}"
  local answer=""
  ask_into answer "$prompt" "$default"
  answer="$(echo "$answer" | tr '[:upper:]' '[:lower:]')"
  case "$answer" in
    y|yes|是|"") return 0 ;;
    n|no|否) return 1 ;;
    *)
      if [[ "$default" == "Y" || "$default" == "y" ]]; then
        return 0
      fi
      return 1
      ;;
  esac
}

reject_piped_stdin() {
  if [[ "$NON_INTERACTIVE" == "1" ]] || [[ -t 0 ]]; then
    return 0
  fi
  log_error "$(M pipe_stdin)"
  echo "$(M pipe_stdin_hint)" >&2
  exit 1
}

ensure_logging() {
  if [[ "$LOGGING_STARTED" == "1" ]]; then
    return 0
  fi
  setup_logging
  LOGGING_STARTED=1
}

