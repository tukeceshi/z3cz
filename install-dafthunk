while [[ $# -gt 0 ]]; do
  case "$1" in
    --lang)
      if [[ $# -lt 2 ]]; then
        echo "Missing value for --lang / --lang 缺少参数 (zh|en|ask)" >&2
        exit 1
      fi
      LANG_FLAG="$2"
      shift 2
      ;;
    --lang=*)
      LANG_FLAG="${1#--lang=}"
      shift
      ;;
    --resume)
      RESUME=1
      SKIP_DOCKER=1
      shift
      ;;
    --skip-docker)
      SKIP_DOCKER=1
      shift
      ;;
    --skip-swap)
      SKIP_SWAP=1
      shift
      ;;
    --force-setup)
      FORCE_SETUP=1
      shift
      ;;
    --non-interactive)
      NON_INTERACTIVE=1
      shift
      ;;
    -h|--help)
      SHOW_HELP=1
      shift
      ;;
    *)
      # Language may still be default zh for this early error
      if [[ -n "$LANG_FLAG" ]] && normalize_lang "$LANG_FLAG" >/dev/null 2>&1; then
        UI_LANG="$(normalize_lang "$LANG_FLAG")"
      elif [[ -n "${DAFTHUNK_LANG:-}" ]] && normalize_lang "${DAFTHUNK_LANG}" >/dev/null 2>&1; then
        UI_LANG="$(normalize_lang "${DAFTHUNK_LANG}")"
      fi
      log_error "$(M unknown_opt "$1")"
      show_help
      exit 1
      ;;
  esac
done

# Resolve language for --help without interactive menu
if [[ "$SHOW_HELP" == "1" ]]; then
  if [[ -n "$LANG_FLAG" ]]; then
    UI_LANG="$(normalize_lang "$LANG_FLAG")" || {
      echo "Invalid --lang '$LANG_FLAG' (use zh, en, or ask)." >&2
      exit 1
    }
  elif [[ -n "${DAFTHUNK_LANG:-}" ]]; then
    UI_LANG="$(normalize_lang "$DAFTHUNK_LANG")" || {
      echo "Invalid DAFTHUNK_LANG='$DAFTHUNK_LANG' (use zh, en, or ask)." >&2
      exit 1
    }
  else
    UI_LANG="zh"
  fi
  [[ "$UI_LANG" == "ask" ]] && UI_LANG="zh"
  show_help
  exit 0
fi

check_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    log_error "$(M need_root)"
    echo
    echo "$(M run_with_sudo)"
    echo "  $INSTALL_ONE_LINER"
    echo "  sudo bash $INSTALL_DIR/install-dafthunk --resume"
    exit 1
  fi
}

setup_logging() {
  touch "$TEMP_LOG"
  exec > >(tee -a "$TEMP_LOG") 2>&1
  log_info "$(M logging_to "$TEMP_LOG")"
}

promote_log() {
  local final="${DAFTHUNK_INSTALL_LOG:-$INSTALL_DIR/install.log}"
  if [[ ! -d "$INSTALL_DIR" ]] || [[ ! -f "$TEMP_LOG" ]]; then
    return 0
  fi
  mkdir -p "$INSTALL_DIR"
  cat "$TEMP_LOG" >>"$final"
  LOG_FILE="$final"
  exec > >(tee -a "$final") 2>&1
  log_info "$(M install_log "$LOG_FILE")"
}

setup_log_path() {
  printf '%s' "${DAFTHUNK_SETUP_LOG:-$INSTALL_DIR/setup.log}"
}

rebuild_log_path() {
  printf '%s' "${DAFTHUNK_REBUILD_LOG:-$INSTALL_DIR/rebuild.log}"
}

read_rebuild_exit() {
  local f="$INSTALL_DIR/$REBUILD_EXIT_FILE"
  local c=""
  [[ -f "$f" ]] || return 1
  c="$(tr -d '[:space:]' <"$f")"
  rm -f "$f"
  [[ "$c" =~ ^[0-9]+$ ]] || return 1
  return "$c"
}

wait_for_tmux_session() {
  local session="$1"
  while tmux has-session -t "$session" 2>/dev/null; do
    sleep 3
  done
}

wait_for_screen_session() {
  local session="$1"
  while screen -list 2>/dev/null | grep -q "[.]${session}[[:space:]]"; do
    sleep 3
  done
}

run_rebuild_logged() {
  local log="$1"
  mkdir -p "$(dirname "$log")"
  : >"$log"
  ./launcher rebuild 2>&1 | tee -a "$log"
  return "${PIPESTATUS[0]}"
}

print_install_summary() {
  local rc="$1"
  local app_yml="$INSTALL_DIR/docker-host/containers/app.yml"
  local setup_log rebuild_log hostname web_host
  setup_log="$(setup_log_path)"
  rebuild_log="$(rebuild_log_path)"
  hostname=""
  web_host=""
  if [[ -f "$app_yml" ]]; then
    hostname="$(grep -E '^hostname:' "$app_yml" | head -n1 | sed 's/^hostname:[[:space:]]*//')"
    web_host="$(grep -E 'WEB_HOST:' "$app_yml" | head -n1 | sed 's/.*WEB_HOST:[[:space:]]*//' | tr -d '"')"
  fi
  echo ""
  log_info "$(M summary_title)"
  [[ -n "$hostname" ]] && log_info "$(M summary_domain "$hostname")"
  [[ -n "$web_host" ]] && log_info "$(M summary_url "$web_host")"
  log_info "$(M summary_logs "$LOG_FILE")"
  log_info "$(M summary_log_line "$setup_log")"
  log_info "$(M summary_log_line "$rebuild_log")"
  [[ -f "$APT_LOG" ]] && log_info "$(M summary_log_line "$APT_LOG")"
  if ((rc == 0)); then
    log_info "$(M summary_ready)"
  else
    log_info "$(M summary_failed)"
    log_info "$(M summary_resume)"
  fi
  log_info "$(M summary_end)"
}

mem_total_mib() {
  local kb
  kb="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  echo $((kb / 1024))
}

swap_total_mib() {
  local kb
  kb="$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)"
  echo $((kb / 1024))
}

mib_to_display() {
  local mib="$1"
  if ((mib % 1024 == 0)); then
    echo "$((mib / 1024))G"
  else
    echo "${mib}M"
  fi
}

# Round MiB to a whole-GiB tier for user-facing "实际内存：2G" (1935 → 2G).
mib_to_gib_tier() {
  local mib="$1"
  local gib=$(((mib + 512) / 1024))
  if ((gib < 1)); then
    gib=1
  fi
  echo "${gib}G"
}

target_req_display() {
  echo "$(((TARGET_TOTAL_MIB + 1023) / 1024))G+"
}

# Parse swap choice: 0 | 2–4 | 2g → MiB. Default GiB when invalid.
parse_swap_gib_choice() {
  local raw="$1"
  local default_gib="${2:-2}"
  raw="$(echo "$raw" | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
  if [[ -z "$raw" ]]; then
    echo $((default_gib * 1024))
    return 0
  fi
  if [[ "$raw" == "0" ]]; then
    echo 0
    return 0
  fi
  if [[ "$raw" =~ ^([2-4])g(ib)?$ ]] || [[ "$raw" =~ ^([2-4])$ ]]; then
    echo $((BASH_REMATCH[1] * 1024))
    return 0
  fi
  return 1
}

ensure_swap() {
  if [[ "$SKIP_SWAP" == "1" ]]; then
    log_info "$(M skip_swap)"
    return 0
  fi

  log_step "$(M step_memory)"
  local mem swap usable answer size_mib req_label ram_label default_gib=2
  mem="$(mem_total_mib)"
  swap="$(swap_total_mib)"
  usable=$((mem + swap))
  req_label="$(target_req_display)"
  ram_label="$(mib_to_gib_tier "$mem")"

  # Soft-meet: within slack of target → pass, no prompts.
  if ((usable + RAM_SLACK_MIB >= TARGET_TOTAL_MIB)); then
    log_info "$(M mem_pass "$req_label" "$(mib_to_gib_tier "$usable")")"
    log_info "$(M mem_skip_swap)"
    return 0
  fi

  echo "$(M mem_need_req "$req_label")" >&2
  echo "$(M mem_need_actual "$ram_label")" >&2
  ask_into answer "$(M mem_need_swap_prompt)" "$default_gib"
  if ! size_mib="$(parse_swap_gib_choice "$answer" "$default_gib")"; then
    log_warn "$(M swap_invalid "$answer" "$default_gib")"
    size_mib=$((default_gib * 1024))
  fi

  if ((size_mib == 0)); then
    log_info "$(M swap_skip_create)"
    return 0
  fi

  if [[ -f "$SWAPFILE" ]]; then
    log_info "$(M swap_replacing "$SWAPFILE")"
    swapoff "$SWAPFILE" 2>/dev/null || true
    rm -f "$SWAPFILE"
  fi
  # Drop any prior fstab entry for this path (line may start at column 0)
  if [[ -f /etc/fstab ]]; then
    grep -vE "(^|[[:space:]])${SWAPFILE}([[:space:]]|$)" /etc/fstab >"/etc/fstab.dafthunk.bak.$$" || true
    mv "/etc/fstab.dafthunk.bak.$$" /etc/fstab
  fi

  log_step "$(M step_swap_create "$(mib_to_display "$size_mib")" "$SWAPFILE")"
  if ! fallocate -l "${size_mib}M" "$SWAPFILE" 2>/dev/null; then
    log_warn "$(M swap_fallocate_fail)"
    dd if=/dev/zero of="$SWAPFILE" bs=1M count="$size_mib" status=progress
  fi
  chmod 600 "$SWAPFILE"
  mkswap "$SWAPFILE"
  swapon "$SWAPFILE"
  if ! grep -qE "(^|[[:space:]])${SWAPFILE}([[:space:]]|$)" /etc/fstab 2>/dev/null; then
    echo "$SWAPFILE none swap sw 0 0" >>/etc/fstab
  fi
  log_info "$(M swap_active "$(mib_to_display "$(($(mem_total_mib) + $(swap_total_mib)))")")"
}

detect_timezone() {
  local tz=""
  if command -v timedatectl >/dev/null 2>&1; then
    tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
  fi
  if [[ -z "$tz" && -f /etc/timezone ]]; then
    tz="$(tr -d '[:space:]' </etc/timezone || true)"
  fi
  if [[ -z "$tz" && -L /etc/localtime ]]; then
    local resolved
    resolved="$(readlink -f /etc/localtime 2>/dev/null || true)"
    if [[ "$resolved" == *"/zoneinfo/"* ]]; then
      tz="${resolved##*/zoneinfo/}"
    fi
  fi
  printf '%s' "$tz"
}

ensure_timezone() {
  log_step "$(M step_timezone)"
  local current new_tz
  current="$(detect_timezone)"
  if [[ -z "$current" ]]; then
    log_warn "$(M tz_detect_fail)"
    return 0
  fi

  log_info "$(M tz_current "$current")"
  if ask_yes_no "$(M tz_keep_prompt)" "Y"; then
    log_info "$(M tz_kept "$current")"
    return 0
  fi

  new_tz=""
  ask_into new_tz "$(M tz_new_prompt "$TZ_SUGGEST")" "$TZ_SUGGEST"
  if [[ -z "$new_tz" ]]; then
    new_tz="$TZ_SUGGEST"
  fi

  if ! command -v timedatectl >/dev/null 2>&1; then
    log_warn "$(M tz_no_timedatectl)"
    return 0
  fi

  if timedatectl set-timezone "$new_tz"; then
    log_info "$(M tz_set_ok "$(detect_timezone)")"
  else
    log_warn "$(M tz_set_fail "$new_tz")"
  fi
}

has_docker_compose() {
  if docker compose version >/dev/null 2>&1; then
    return 0
  fi
  if command -v docker-compose >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

install_packages_apt() {
  # System upgrade is intentionally not run here (can restart sshd / drop SSH).
  # Docs recommend optional: apt-get update && apt-get upgrade -y
  touch "$APT_LOG"
  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE="${NEEDRESTART_MODE:-a}"

  log_step "$(M step_apt)"
  if ! apt-get update -y -qq -o Dpkg::Use-Pty=0 >>"$APT_LOG" 2>&1; then
    log_error "$(M apt_failed "$APT_LOG")"
    tail -n 50 "$APT_LOG" >&2 || true
    exit 1
  fi

  log_step "$(M step_docker_pkgs)"
  local pkgs=(docker.io git ca-certificates curl tmux)
  if apt-cache show docker-compose-v2 >/dev/null 2>&1; then
    pkgs+=(docker-compose-v2)
  else
    pkgs+=(docker-compose)
  fi
  if apt-cache show docker-buildx-plugin >/dev/null 2>&1; then
    pkgs+=(docker-buildx-plugin)
  fi
  if ! apt-get install -y -qq -o Dpkg::Use-Pty=0 "${pkgs[@]}" >>"$APT_LOG" 2>&1; then
    log_error "$(M apt_failed "$APT_LOG")"
    tail -n 60 "$APT_LOG" >&2 || true
    exit 1
  fi

  systemctl enable --now docker 2>/dev/null || service docker start 2>/dev/null || true

  if ! command -v docker >/dev/null 2>&1; then
    log_error "$(M docker_missing)"
    exit 1
  fi
  if ! has_docker_compose; then
    log_error "$(M compose_missing)"
    exit 1
  fi
  announce "$(M docker_ready)"
  log_info "Docker $(docker --version 2>/dev/null | head -n1)"
  docker compose version 2>/dev/null || docker-compose version 2>/dev/null || true
  log_info "$(M prepull_image "$NODE_IMAGE")"
  if ! docker pull "$NODE_IMAGE" >>"$APT_LOG" 2>&1; then
    log_warn "$(M prepull_skip "$NODE_IMAGE")"
  fi
}

install_packages_get_docker() {
  log_step "$(M step_get_docker)"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL https://get.docker.com | sh
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://get.docker.com | sh
  else
    log_error "$(M need_curl_wget)"
    exit 1
  fi
  systemctl enable --now docker 2>/dev/null || true
  if command -v dnf >/dev/null 2>&1; then
    dnf -y install git || true
  elif command -v yum >/dev/null 2>&1; then
    yum -y install git || true
  fi
  announce "$(M docker_ready)"
  if command -v docker >/dev/null 2>&1; then
    log_info "$(M prepull_image "$NODE_IMAGE")"
    docker pull "$NODE_IMAGE" >>"$APT_LOG" 2>&1 || log_warn "$(M prepull_skip "$NODE_IMAGE")"
  fi
}

prepare_host_interactive() {
  log_step "$(M step_host)"
  if can_prompt; then
    ask_status "$(M interactive_section)"
  fi
  ensure_swap
  ensure_timezone
}

setup_repo() {
  log_step "$(M step_repo)"

  if [[ -d "$INSTALL_DIR/.git" ]]; then
    log_info "$(M existing_install "$INSTALL_DIR")"
    log_info "$(M updating_repo)"
    cd "$INSTALL_DIR"
    git fetch origin
    git reset --hard "origin/$BRANCH"
  else
    if [[ -d "$INSTALL_DIR" ]]; then
      if [[ -n "$(ls -A "$INSTALL_DIR" 2>/dev/null || true)" ]]; then
        local backup="${INSTALL_DIR}.backup.$(date +%Y%m%d%H%M%S)"
        log_warn "$(M backup_dir "$INSTALL_DIR" "$backup")"
        mv "$INSTALL_DIR" "$backup"
      else
        rmdir "$INSTALL_DIR"
      fi
    fi

    log_info "$(M cloning "$INSTALL_DIR")"
    git clone --depth=1 --branch "$BRANCH" "$REPO_URL" "$INSTALL_DIR"
  fi

  cd "$INSTALL_DIR"
  chmod +x docker-host/dafthunk-setup docker-host/launcher install-dafthunk 2>/dev/null || true
  # Optional overlay (e.g. /tmp/deploy/dafthunk-setup) while GitHub raw is catching up.
  if [[ -f "${DAFTHUNK_SETUP_OVERLAY:-/tmp/deploy/dafthunk-setup}" ]]; then
    cp "${DAFTHUNK_SETUP_OVERLAY:-/tmp/deploy/dafthunk-setup}" docker-host/dafthunk-setup
    chmod +x docker-host/dafthunk-setup
  fi
  # Normalize CRLF if scripts were ever edited on Windows
  sed -i 's/\r$//' docker-host/dafthunk-setup docker-host/launcher install-dafthunk 2>/dev/null || true
  mkdir -p "$INSTALL_DIR/docker-host"
  printf '%s\n' "$UI_LANG" >"$INSTALL_DIR/docker-host/.install-lang"
  promote_log
  log_info "$(M repo_ready "$INSTALL_DIR")"
}

print_resume_hint() {
  echo
  log_warn "$(M disconnect_hint)"
  echo "  cd $INSTALL_DIR/docker-host && ./launcher rebuild"
  echo "$(M or_resume)"
  echo "  sudo bash $INSTALL_DIR/install-dafthunk --resume"
  echo "$(M log_label "$LOG_FILE")"
  echo
}

try_attach_tmux() {
  local session="$1"
  if ! can_prompt; then
    return 0
  fi
  if tmux attach -t "$session" 2>/dev/null; then
    return 0
  fi
  log_warn "$(M tmux_attach_fail "$session")"
  return 0
}

try_attach_screen() {
  local session="$1"
  if ! can_prompt; then
    return 0
  fi
  if screen -r "$session" 2>/dev/null; then
    return 0
  fi
  log_warn "$(M screen_attach_fail "$session")"
  return 0
}

run_launcher_rebuild() {
  local rebuild_log exit_file rc=0 session
  rebuild_log="$(rebuild_log_path)"
  exit_file="$INSTALL_DIR/$REBUILD_EXIT_FILE"
  mkdir -p "$INSTALL_DIR"
  rm -f "$exit_file"
  print_resume_hint
  cd "$INSTALL_DIR/docker-host"
  log_info "$(M rebuild_log_label "$rebuild_log")"

  if command -v tmux >/dev/null 2>&1 && [[ -z "${TMUX:-}" ]]; then
    session="dafthunk-install"
    if tmux has-session -t "$session" 2>/dev/null; then
      log_warn "$(M tmux_exists "$session")"
    else
      log_info "$(M tmux_start "$session")"
      if ! tmux new-session -d -s "$session" bash -c \
        "cd '$INSTALL_DIR/docker-host' && { ./launcher rebuild 2>&1 | tee -a '$rebuild_log'; echo \${PIPESTATUS[0]} > '$exit_file'; exit \${PIPESTATUS[0]}; }"; then
        log_warn "$(M tmux_start_fail)"
        run_rebuild_logged "$rebuild_log"
        return $?
      fi
    fi
    if ! tmux has-session -t "$session" 2>/dev/null; then
      log_warn "$(M tmux_start_fail)"
      run_rebuild_logged "$rebuild_log"
      return $?
    fi
    log_info "$(M tmux_reattach "$session")"
    try_attach_tmux "$session"
    log_info "$(M rebuild_running "$rebuild_log")"
    wait_for_tmux_session "$session"
    read_rebuild_exit
    rc=$?
    return "$rc"
  fi

  if command -v screen >/dev/null 2>&1 && [[ -z "${STY:-}" ]]; then
    session="dafthunk-install"
    if screen -list 2>/dev/null | grep -q "[.]${session}[[:space:]]"; then
      log_warn "$(M screen_exists "$session")"
    else
      log_info "$(M screen_start "$session")"
      if ! screen -dmS "$session" bash -c \
        "cd '$INSTALL_DIR/docker-host' && { ./launcher rebuild 2>&1 | tee -a '$rebuild_log'; echo \${PIPESTATUS[0]} > '$exit_file'; exit \${PIPESTATUS[0]}; }"; then
        log_warn "$(M screen_start_fail)"
        run_rebuild_logged "$rebuild_log"
        return $?
      fi
    fi
    if ! screen -list 2>/dev/null | grep -q "[.]${session}[[:space:]]"; then
      log_warn "$(M screen_start_fail)"
      run_rebuild_logged "$rebuild_log"
      return $?
    fi
    log_info "$(M screen_reattach "$session")"
    try_attach_screen "$session"
    log_info "$(M rebuild_running "$rebuild_log")"
    wait_for_screen_session "$session"
    read_rebuild_exit
    rc=$?
    return "$rc"
  fi

  if ! can_prompt; then
    log_warn "$(M no_tty_rebuild)"
  else
    log_warn "$(M no_tmux_screen)"
  fi

  run_rebuild_logged "$rebuild_log"
  return $?
}

run_setup_and_rebuild() {
  local app_yml="$INSTALL_DIR/docker-host/containers/app.yml"
  local setup_log rebuild_rc=0
  cd "$INSTALL_DIR/docker-host"

  if [[ ! -f "./dafthunk-setup" ]] || [[ ! -f "./launcher" ]]; then
    log_error "$(M setup_missing "$INSTALL_DIR/docker-host")"
    exit 1
  fi

  if [[ -f "$app_yml" ]] && [[ "$FORCE_SETUP" != "1" ]]; then
    log_step "$(M config_present)"
    log_info "$(M found_yml "$app_yml")"
    run_launcher_rebuild
    return $?
  fi

  log_step "$(M step_setup_rebuild)"
  setup_log="$(setup_log_path)"
  : >"$setup_log"
  log_info "$(M setup_log_label "$setup_log")"
  log_info "$(M setup_terminal_hint)"
  echo
  if [[ -r /dev/tty && -w /dev/tty ]]; then
    DAFTHUNK_FROM_INSTALL=1 DAFTHUNK_LANG="$UI_LANG" DAFTHUNK_ASK_TIMEOUT="$ASK_TIMEOUT_SEC" \
      DAFTHUNK_NON_INTERACTIVE="$NON_INTERACTIVE" DAFTHUNK_SETUP_LOG="$setup_log" \
      bash ./dafthunk-setup --no-rebuild 0</dev/tty >/dev/tty 2>&1
  else
    DAFTHUNK_FROM_INSTALL=1 DAFTHUNK_LANG="$UI_LANG" DAFTHUNK_ASK_TIMEOUT="$ASK_TIMEOUT_SEC" \
      DAFTHUNK_NON_INTERACTIVE="$NON_INTERACTIVE" DAFTHUNK_SETUP_LOG="$setup_log" \
      bash ./dafthunk-setup --no-rebuild
  fi
  run_launcher_rebuild || rebuild_rc=$?
  return "$rebuild_rc"
}

apply_lang_from_flag_or_env
check_root
reject_piped_stdin
ensure_stdin_tty
choose_ui_lang_interactive

