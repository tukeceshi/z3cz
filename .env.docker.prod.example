# 复制为 .env.docker.prod 后使用（或运行 node scripts/sync-env-docker-prod.mjs 从 .dev.vars 同步密钥）：
#   docker compose -f docker-compose.prod.yml --env-file .env.docker.prod up --build -d

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

WWW_PORT=3100
APP_PORT=3101
API_PORT=3102
SMTP_PORT=2525

# 启动 prod-api 时是否执行 drizzle migrate
RUN_DB_MIGRATE=true

# API 密钥（必填）— 可用 generate-master-key.js 生成，或 sync-env-docker-prod.mjs 从 .dev.vars 复制
JWT_SECRET=change-me-run-generate-master-key
SECRET_MASTER_KEY=change-me-run-generate-master-key

# 对外 URL（OAuth 回调、邮件链接等）
WEB_HOST=http://localhost:3101
WEBSITE_URL=http://localhost:3100
EMAIL_DOMAIN=mail.dafthunk.com

# 入站邮件：HTTP webhook 与 SMTP 网关共用此密钥
INBOUND_EMAIL_SECRET=change-me-in-production

# 前端 / www 构建时注入（与上面 URL 保持一致）
VITE_API_HOST=http://localhost:3102
VITE_APP_URL=http://localhost:3101
VITE_WEBSITE_URL=http://localhost:3100
VITE_CONTACT_EMAIL=hello@dafthunk.com

# 对象存储：默认本地 FS（LOCAL_STORAGE_PATH 在 compose 中注入）
# 设置 COS_* 将在启动时尝试 COS 适配器（尚未实现，会报错）
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_BUCKET=
# COS_REGION=
# COS_ENDPOINT=

# 可选：Cloudflare AI / R2 / Analytics（未配置时使用本地 stub）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ENV=production
