#!/usr/bin/env bash
# Discourse-style launcher for Dafthunk Docker self-host.
# Host requirements: bash + Docker. Node optional (used if present for render).
set -euo pipefail

HOST_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOST_DIR/.." && pwd)"
APP_YML="$HOST_DIR/containers/app.yml"
COMPOSE_FILE="$HOST_DIR/docker-compose.generated.yml"
ENV_FILE="$HOST_DIR/.env.generated"
NODE_IMAGE="${DAFTHUNK_NODE_IMAGE:-node:22.12.0-bookworm-slim}"
HUB_PULL_MIRRORS="${DAFTHUNK_DOCKER_PULL_MIRRORS:-docker.m.daocloud.io docker.1ms.run}"

COMMAND="${1:-help}"
shift || true

print_help() {
  cat <<EOF
Dafthunk host launcher

Usage: ./launcher <command>

Commands:
  render      Generate compose / Caddyfile / env from containers/app.yml
  pull-images Pull postgres/caddy/node (Docker Hub, then mirrors)
  bootstrap   Alias of rebuild (first install)
  rebuild     Start packaged images, recreate stack (keeps shared/ data)
  start       Start existing stack
  stop        Stop stack
  restart     Restart stack
  destroy     Remove containers (keeps shared/)
  logs        docker compose logs (pass-through args)
  enter       Shell into a service: enter api|app|caddy|postgres
  status      docker compose ps
  help        Show this help

First install:
  ./dafthunk-setup

If start is interrupted (SSH drop):
  ./launcher rebuild
  # shared/ data is kept
EOF
}

require_app_yml() {
  if [[ -f "$APP_YML" ]]; then
    return 0
  fi

  case "$COMMAND" in
    bootstrap|rebuild|start)
      echo "Missing containers/app.yml — running ./dafthunk-setup (writes config, then rebuilds)..." >&2
      exec bash "$HOST_DIR/dafthunk-setup"
      ;;
    *)
      echo "Missing containers/app.yml." >&2
      echo "Run: ./dafthunk-setup" >&2
      echo "Or:  cp samples/standalone.yml containers/app.yml" >&2
      exit 1
      ;;
  esac
}

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
  else
    echo "Neither 'docker compose' nor 'docker-compose' found." >&2
    exit 1
  fi
}

docker_pull() {
  local ref="$1"
  local secs="${2:-90}"
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" docker pull "$ref" || return 1
    return 0
  fi
  docker pull "$ref" || return 1
}

# Pull an official image from Docker Hub, then public mirrors. Does not install Node on the host.
ensure_hub_image() {
  local img="$1"
  if docker image inspect "$img" >/dev/null 2>&1; then
    return 0
  fi
  echo "→ Pulling $img ..."
  if docker_pull "$img" 30; then
    return 0
  fi
  echo "→ Docker Hub failed, trying mirrors for $img ..."
  local path="${img#docker.io/}"
  if [[ "$path" != */* ]]; then
    path="library/${path}"
  fi
  local m mirrored
  for m in $HUB_PULL_MIRRORS; do
    m="${m#https://}"
    m="${m%/}"
    mirrored="${m}/${path}"
    echo "→ Pulling $mirrored"
    if docker_pull "$mirrored" 90; then
      docker tag "$mirrored" "$img"
      return 0
    fi
  done
  echo "ERROR: could not pull $img from Docker Hub or mirrors" >&2
  exit 1
}

ensure_hub_images() {
  ensure_hub_image "$NODE_IMAGE"
  ensure_hub_image "postgres:16-alpine"
  ensure_hub_image "caddy:2.9-alpine"
}

run_render() {
  require_app_yml
  mkdir -p \
    "$HOST_DIR/shared/postgres" \
    "$HOST_DIR/shared/storage" \
    "$HOST_DIR/shared/caddy" \
    "$HOST_DIR/shared/caddy-config" \
    "$HOST_DIR/shared/backups"

  if command -v node >/dev/null 2>&1; then
    (cd "$REPO_ROOT" && node docker-host/launcher.mjs render)
    return
  fi

  if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required to render config (Node is not installed on the host)." >&2
    exit 1
  fi

  ensure_hub_image "$NODE_IMAGE"
  echo "→ Rendering config with $NODE_IMAGE ..."
  docker run --rm \
    -v "$REPO_ROOT:/repo:rw" \
    -w /repo \
    "$NODE_IMAGE" \
    node docker-host/launcher.mjs render
}

ensure_generated() {
  require_app_yml
  if [[ ! -f "$COMPOSE_FILE" || ! -f "$ENV_FILE" ]]; then
    run_render
  fi
}

case "$COMMAND" in
  help|-h|--help)
    print_help
    ;;
  render)
    run_render
    ;;
  pull-images)
    ensure_hub_images
    ;;
  bootstrap|rebuild)
    echo ""
    echo "Note: if SSH disconnects, reconnect and run: ./launcher rebuild"
    echo "      (shared/ data is kept; logs: ../install.log, ../setup.log, ../rebuild.log)"
    echo ""
    run_render
    ensure_hub_images
    compose up -d --wait --remove-orphans postgres
    compose up -d --force-recreate --no-deps api app
    compose up -d --remove-orphans
    ;;
  start)
    run_render
    ensure_hub_images
    compose up -d
    ;;
  stop)
    ensure_generated
    compose stop
    ;;
  restart)
    ensure_generated
    compose restart
    ;;
  destroy)
    ensure_generated
    echo "Removing containers (shared/ data kept)..."
    compose down --remove-orphans
    ;;
  logs)
    ensure_generated
    compose logs "$@"
    ;;
  status|ps)
    ensure_generated
    compose ps "$@"
    ;;
  enter)
    service="${1:-}"
    if [[ -z "$service" ]]; then
      echo "Usage: ./launcher enter api|app|caddy|postgres" >&2
      exit 1
    fi
    shift || true
    ensure_generated
    compose exec -it "$service" sh "$@"
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    print_help
    exit 1
    ;;
esac
