#!/usr/bin/env bash
# Discourse-style interactive setup for Dafthunk Docker self-host.
# Host requirements: bash, openssl (or /dev/urandom). No Node required.
# After writing containers/app.yml, runs ./launcher rebuild unless --no-rebuild.
set -euo pipefail

HOST_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOST_DIR/.." && pwd)"
APP_YML="$HOST_DIR/containers/app.yml"

SKIP_REBUILD=0
for arg in "$@"; do
  case "$arg" in
    --no-rebuild) SKIP_REBUILD=1 ;;
    -h|--help)
      echo "Usage: ./dafthunk-setup [--no-rebuild]"
      echo "  Writes containers/app.yml, then runs ./launcher rebuild (default)."
      exit 0
      ;;
  esac
done

# Language: DAFTHUNK_LANG > .install-lang > zh
UI_LANG="zh"
if [[ -n "${DAFTHUNK_LANG:-}" ]]; then
  case "$(echo "$DAFTHUNK_LANG" | tr '[:upper:]' '[:lower:]')" in
    en|en-us|en_us|english) UI_LANG="en" ;;
    *) UI_LANG="zh" ;;
  esac
elif [[ -f "$HOST_DIR/.install-lang" ]]; then
  case "$(tr -d '[:space:]' <"$HOST_DIR/.install-lang" | tr '[:upper:]' '[:lower:]')" in
    en|en-us|en_us|english) UI_LANG="en" ;;
    *) UI_LANG="zh" ;;
  esac
fi

M() {
  local key="$1"
  shift || true
  case "$UI_LANG" in
    en)
      case "$key" in
        title) echo "Dafthunk self-host setup" ;;
        rule) echo "------------------------" ;;
        admin_hint) echo "Admin account: open the site after rebuild and register — the first user becomes platform admin." ;;
        hostname) echo "Hostname / domain [localhost]: " ;;
        local_http) echo "Local hostname detected — HTTPS disabled (HTTP only)." ;;
        https) echo "Enable HTTPS / Let's Encrypt? [Y/n]: " ;;
        le_email) echo "ACME notification email (optional, Enter to skip): " ;;
        http_port) echo "HTTP port [$1]: " ;;
        https_port) echo "HTTPS port [$1]: " ;;
        bad_port) echo "Invalid port '$1' — using default $2" ;;
        existing_yml) echo "Existing containers/app.yml found — preserving secrets when valid." ;;
        wrote) echo "Wrote docker-host/containers/app.yml" ;;
        public_url) echo "Public URL: $1" ;;
        skip_rebuild) echo "Skipped rebuild (--no-rebuild). Next: ./launcher rebuild" ;;
        then_register) echo "Then open $1 and register the first user (platform admin)." ;;
        starting_rebuild) echo "Starting ./launcher rebuild..." ;;
        when_ready) echo "When ready, open $1 and register the first user (platform admin)." ;;
        *) echo "[$key $*]"; ;;
      esac
      ;;
    *)
      case "$key" in
        title) echo "Dafthunk 自托管配置" ;;
        rule) echo "------------------------" ;;
        admin_hint) echo "管理员账号：重建完成后打开站点注册 — 首个用户将成为平台管理员。" ;;
        hostname) echo "域名 / Hostname [localhost]: " ;;
        local_http) echo "检测到本地主机名 — 已关闭 HTTPS（仅 HTTP）。" ;;
        https) echo "启用 HTTPS / Let's Encrypt？ [Y/n]: " ;;
        le_email) echo "ACME 通知邮箱（可选，回车跳过）: " ;;
        http_port) echo "HTTP 端口 [$1]: " ;;
        https_port) echo "HTTPS 端口 [$1]: " ;;
        bad_port) echo "无效端口「$1」— 改用默认 $2" ;;
        existing_yml) echo "发现已有 containers/app.yml — 在密钥有效时予以保留。" ;;
        wrote) echo "已写入 docker-host/containers/app.yml" ;;
        public_url) echo "公网地址: $1" ;;
        skip_rebuild) echo "已跳过 rebuild (--no-rebuild)。下一步: ./launcher rebuild" ;;
        then_register) echo "然后打开 $1 注册首个用户（平台管理员）。" ;;
        starting_rebuild) echo "正在执行 ./launcher rebuild..." ;;
        when_ready) echo "就绪后打开 $1 注册首个用户（平台管理员）。" ;;
        *) echo "[$key $*]"; ;;
      esac
      ;;
  esac
}

mkdir -p \
  "$HOST_DIR/containers" \
  "$HOST_DIR/shared/postgres" \
  "$HOST_DIR/shared/storage" \
  "$HOST_DIR/shared/caddy" \
  "$HOST_DIR/shared/backups"

hex_secret() {
  local bytes="${1:-32}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  else
    head -c "$bytes" /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

is_placeholder() {
  local value="${1:-}"
  [[ -z "$value" ]] && return 0
  [[ "$value" == "CHANGE_ME" || "$value" == "change-me" ]] && return 0
  [[ "$value" == change-me* || "$value" == dev-insecure-* ]] && return 0
  return 1
}

looks_like_local() {
  local host="$1"
  case "$host" in
    localhost|127.0.0.1) return 0 ;;
  esac
  if [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    return 0
  fi
  return 1
}

public_origin() {
  local hostname="$1" https="$2" http_port="$3" https_port="$4"
  if [[ "$https" == "true" ]]; then
    if [[ "$https_port" != "443" ]]; then
      echo "https://${hostname}:${https_port}"
    else
      echo "https://${hostname}"
    fi
  else
    if [[ "$http_port" != "80" ]]; then
      echo "http://${hostname}:${http_port}"
    else
      echo "http://${hostname}"
    fi
  fi
}

yml_escape() {
  local value="$1"
  if [[ "$value" =~ [[:space:]:#] ]] || [[ "$value" =~ [\{\}\[\],\&\*\?\|\!\%\@\`] ]]; then
    python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$value" 2>/dev/null \
      || node -e 'console.log(JSON.stringify(process.argv[1]))' "$value" 2>/dev/null \
      || printf '"%s"' "${value//\"/\\\"}"
  else
    printf '%s' "$value"
  fi
}

read_env_value() {
  local key="$1" file="$2"
  [[ -f "$file" ]] || return 0
  # Match "  KEY: value" under env: (best-effort; same subset as parse-app-yml)
  local line
  line="$(grep -E "^[[:space:]]+${key}:" "$file" | head -n1 || true)"
  [[ -n "$line" ]] || return 0
  local value="${line#*:}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

# wget|bash leaves stdin as a pipe — read answers from the real console when possible.
ask_line() {
  local prompt="$1"
  local default="${2:-}"
  local value=""
  if [[ -r /dev/tty && -w /dev/tty ]]; then
    printf '%s' "$prompt" >/dev/tty
    read -r value </dev/tty || true
  elif [[ -t 0 ]]; then
    read -r -p "$prompt" value || true
  else
    value="$default"
  fi
  if [[ -z "${value:-}" ]]; then
    printf '%s' "$default"
  else
    printf '%s' "$value"
  fi
}

echo "$(M title)"
echo "$(M rule)"
echo "$(M admin_hint)"
echo ""

hostname="$(ask_line "$(M hostname)" "localhost")"

https="true"
if looks_like_local "$hostname"; then
  echo "$(M local_http)"
  https="false"
else
  https_answer="$(ask_line "$(M https)" "Y")"
  https_answer="$(echo "${https_answer:-}" | tr '[:upper:]' '[:lower:]')"
  if [[ "$https_answer" == "n" || "$https_answer" == "no" || "$https_answer" == "否" ]]; then
    https="false"
  fi
fi

le_email=""
if [[ "$https" == "true" ]]; then
  le_email="$(ask_line "$(M le_email)" "")"
fi

read_port() {
  local prompt="$1"
  local default="$2"
  local value
  value="$(ask_line "$prompt" "$default")"
  if [[ ! "$value" =~ ^[0-9]+$ ]] || ((value < 1 || value > 65535)); then
    echo "$(M bad_port "$value" "$default")" >&2
    value="$default"
  fi
  printf '%s' "$value"
}

if [[ "$https" == "true" ]]; then
  http_port="$(read_port "$(M http_port "80")" "80")"
  https_port="$(read_port "$(M https_port "443")" "443")"
else
  http_port="$(read_port "$(M http_port "8080")" "8080")"
  https_port=443
fi

jwt=""
master=""
if [[ -f "$APP_YML" ]]; then
  echo "$(M existing_yml)"
  jwt="$(read_env_value JWT_SECRET "$APP_YML")"
  master="$(read_env_value SECRET_MASTER_KEY "$APP_YML")"
fi

if is_placeholder "$jwt"; then
  jwt="$(hex_secret 32)"
fi
if is_placeholder "$master"; then
  master="$(hex_secret 32)"
fi

web_host="$(public_origin "$hostname" "$https" "$http_port" "$https_port")"

{
  echo "# Generated by dafthunk-setup — do not commit"
  echo "hostname: $hostname"
  echo "https: $https"
  if [[ -n "$le_email" ]]; then
    echo "le_email: $(yml_escape "$le_email")"
  fi
  echo "http_port: $http_port"
  echo "https_port: $https_port"
  echo "env:"
  echo "  JWT_SECRET: $(yml_escape "$jwt")"
  echo "  SECRET_MASTER_KEY: $(yml_escape "$master")"
  echo "  WEB_HOST: $(yml_escape "$web_host")"
  echo "  WEBSITE_URL: $(yml_escape "$web_host")"
  echo ""
} >"$APP_YML"

echo ""
echo "$(M wrote)"
echo "$(M public_url "$web_host")"
echo ""

if [[ "$SKIP_REBUILD" == "1" ]]; then
  echo "$(M skip_rebuild)"
  echo "$(M then_register "$web_host")"
  exit 0
fi

echo "$(M starting_rebuild)"
echo "$(M when_ready "$web_host")"
echo ""
exec "$HOST_DIR/launcher" rebuild
