#!/usr/bin/env bash
# Discourse-style interactive setup for Dafthunk Docker self-host.
# Host requirements: bash, openssl (or /dev/urandom). No Node required.
set -euo pipefail

HOST_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOST_DIR/.." && pwd)"
APP_YML="$HOST_DIR/containers/app.yml"

mkdir -p \
  "$HOST_DIR/containers" \
  "$HOST_DIR/shared/postgres" \
  "$HOST_DIR/shared/storage" \
  "$HOST_DIR/shared/caddy" \
  "$HOST_DIR/shared/backups"

hex_secret() {
  local bytes="${1:-32}"
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex "$bytes"
  else
    head -c "$bytes" /dev/urandom | od -An -tx1 | tr -d ' \n'
  fi
}

is_placeholder() {
  local value="${1:-}"
  [[ -z "$value" ]] && return 0
  [[ "$value" == "CHANGE_ME" || "$value" == "change-me" ]] && return 0
  [[ "$value" == change-me* || "$value" == dev-insecure-* ]] && return 0
  return 1
}

looks_like_local() {
  local host="$1"
  case "$host" in
    localhost|127.0.0.1) return 0 ;;
  esac
  if [[ "$host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    return 0
  fi
  return 1
}

public_origin() {
  local hostname="$1" https="$2" http_port="$3" https_port="$4"
  if [[ "$https" == "true" ]]; then
    if [[ "$https_port" != "443" ]]; then
      echo "https://${hostname}:${https_port}"
    else
      echo "https://${hostname}"
    fi
  else
    if [[ "$http_port" != "80" ]]; then
      echo "http://${hostname}:${http_port}"
    else
      echo "http://${hostname}"
    fi
  fi
}

yml_escape() {
  local value="$1"
  if [[ "$value" =~ [[:space:]:#] ]] || [[ "$value" =~ [\{\}\[\],\&\*\?\|\!\%\@\`] ]]; then
    python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$value" 2>/dev/null \
      || node -e 'console.log(JSON.stringify(process.argv[1]))' "$value" 2>/dev/null \
      || printf '"%s"' "${value//\"/\\\"}"
  else
    printf '%s' "$value"
  fi
}

read_env_value() {
  local key="$1" file="$2"
  [[ -f "$file" ]] || return 0
  # Match "  KEY: value" under env: (best-effort; same subset as parse-app-yml)
  local line
  line="$(grep -E "^[[:space:]]+${key}:" "$file" | head -n1 || true)"
  [[ -n "$line" ]] || return 0
  local value="${line#*:}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

echo "Dafthunk self-host setup"
echo "------------------------"
echo "Admin account: open the site after rebuild and register — the first user becomes platform admin."
echo ""

read -r -p "Hostname [localhost]: " hostname
hostname="${hostname:-localhost}"

https="true"
if looks_like_local "$hostname"; then
  echo "Local hostname detected — HTTPS disabled (HTTP only)."
  https="false"
else
  read -r -p "Enable HTTPS / Let's Encrypt? [Y/n]: " https_answer
  https_answer="$(echo "${https_answer:-}" | tr '[:upper:]' '[:lower:]')"
  if [[ "$https_answer" == "n" || "$https_answer" == "no" ]]; then
    https="false"
  fi
fi

le_email=""
if [[ "$https" == "true" ]]; then
  read -r -p "ACME notification email (optional, Enter to skip): " le_email
fi

if [[ "$https" == "true" ]]; then
  http_port=80
  https_port=443
  read -r -p "HTTP port [80]: " http_answer
  [[ -n "${http_answer:-}" ]] && http_port="$http_answer"
  read -r -p "HTTPS port [443]: " https_answer_port
  [[ -n "${https_answer_port:-}" ]] && https_port="$https_answer_port"
else
  http_port=8080
  https_port=443
  read -r -p "HTTP port [8080]: " port_answer
  [[ -n "${port_answer:-}" ]] && http_port="$port_answer"
fi

jwt=""
master=""
if [[ -f "$APP_YML" ]]; then
  echo "Existing containers/app.yml found — preserving secrets when valid."
  jwt="$(read_env_value JWT_SECRET "$APP_YML")"
  master="$(read_env_value SECRET_MASTER_KEY "$APP_YML")"
fi

if is_placeholder "$jwt"; then
  jwt="$(hex_secret 32)"
fi
if is_placeholder "$master"; then
  master="$(hex_secret 32)"
fi

web_host="$(public_origin "$hostname" "$https" "$http_port" "$https_port")"

{
  echo "# Generated by dafthunk-setup — do not commit"
  echo "hostname: $hostname"
  echo "https: $https"
  if [[ -n "$le_email" ]]; then
    echo "le_email: $(yml_escape "$le_email")"
  fi
  echo "http_port: $http_port"
  echo "https_port: $https_port"
  echo "env:"
  echo "  JWT_SECRET: $(yml_escape "$jwt")"
  echo "  SECRET_MASTER_KEY: $(yml_escape "$master")"
  echo "  WEB_HOST: $(yml_escape "$web_host")"
  echo "  WEBSITE_URL: $(yml_escape "$web_host")"
  echo ""
} >"$APP_YML"

echo ""
echo "Wrote docker-host/containers/app.yml"
echo "Public URL: $web_host"
echo ""
echo "Next:"
echo "  ./launcher rebuild"
echo "  open $web_host and register the first user (platform admin)"
