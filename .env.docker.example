# 可选：复制为 .env.docker（pnpm dev 会自动从本文件创建）
# 默认启动：pnpm dev  或  docker compose up -d

WWW_PORT=3100
APP_PORT=3101
API_PORT=3102
# Cloudflare 凭证（可选；也可使用 docker-compose.cloud.yml）
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

NODE_VERSION=22.12.0
PNPM_VERSION=10.3.0

# 可选同源网关（pnpm dev:gateway → http://localhost:8080）
# GATEWAY_PORT=8080
# VITE_WS_VIA_PROXY=1
