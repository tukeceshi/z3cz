{
  "name": "@dafthunk/runtime-legacy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Legacy workflow node implementations and registration, isolated from the core generative runtime.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
