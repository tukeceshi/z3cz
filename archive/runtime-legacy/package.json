    "@cf-wasm/resvg": "^0.3.4",
    "@dafthunk/geo": "workspace:*",
    "@dafthunk/runtime": "workspace:*",
    "@dafthunk/types": "workspace:*",
    "@dafthunk/utils": "workspace:*",
    "@google/genai": "^1.52.0",
    "@gltf-transform/core": "^4.3.0",
    "@mapbox/martini": "^0.2.0",
    "exifreader": "^4.41.0",
    "geotiff": "^2.1.3",
    "jsonpath-plus": "^10.4.0",
    "openai": "^6.37.0",
    "postal-mime": "^2.7.4",
    "three": "^0.182.0",
    "three-bvh-csg": "^0.0.17",
    "twilio": "^5.13.1",
