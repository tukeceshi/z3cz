    "check": "biome check --write",
    "test": "vitest run",
    "fonts:fetch": "node scripts/fetch-fonts.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@cloudflare/ai-utils": "^1.0.1",
    "@cloudflare/sandbox": "^0.7.21",
    "@dafthunk/geo": "workspace:*",
    "@dafthunk/types": "workspace:*",
    "@dafthunk/utils": "workspace:*",
    "@google/genai": "^1.52.0",
    "jsonpath-plus": "^10.4.0",
    "openai": "^6.37.0",
    "postal-mime": "^2.7.4",
    "twilio": "^5.13.1",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
